          <mxGeometry x="40" y="170" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="token" value="Tokenization&#10;Surrogate token; real value kept in a vault.&#10;Use: PCI DSS card data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0d4d4;strokeColor=#33485f;" vertex="1" parent="1">
          <mxGeometry x="480" y="170" width="380" height="80" as="geometry" />
