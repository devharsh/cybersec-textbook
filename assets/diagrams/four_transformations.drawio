        </mxCell>
        <mxCell id="enc" value="Encoding&#10;Reversible by anyone; no key; no confidentiality.&#10;Use: transport/storage (Base64)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dde7f0;strokeColor=#33485f;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ency" value="Encryption&#10;Reversible with a key; protects confidentiality.&#10;Use: TLS, files at rest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe3d6;strokeColor=#33485f;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="380" height="80" as="geometry" />
        </mxCell>
